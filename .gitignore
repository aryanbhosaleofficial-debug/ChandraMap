# ============================================================
# ChandraMap - Root .gitignore
# ============================================================

# ------------------------------------------------------------
# 1. Environment & Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.crt
secrets/
credentials/
.local/

# ------------------------------------------------------------
# 2. Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.so
*.pyd

# Python packaging
*.egg
*.egg-info/
dist/
build/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python tooling
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json

# Type checking
.dmypy.json
dmypy.json

# ------------------------------------------------------------
# 3. Jupyter / Notebooks
# ------------------------------------------------------------

.ipynb_checkpoints/

# Jupyter temporary files
.jupyter/

# ------------------------------------------------------------
# 4. Node / Frontend
# ------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.pnpm-store/

# Build output
dist/
build/
.vite/
.next/
out/
.cache/

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.template

# ------------------------------------------------------------
# 5. IDE / Editors
# ------------------------------------------------------------

.vscode/*
!.vscode/settings.example.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# 6. Operating System
# ------------------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------
# 7. Logs
# ------------------------------------------------------------

*.log
logs/
log/

# ------------------------------------------------------------
# 8. Temporary Files
# ------------------------------------------------------------

tmp/
temp/
.tmp/
*.tmp
*.temp
*.bak
*.backup
*.old

# ------------------------------------------------------------
# 9. ChandraMap Data
# ------------------------------------------------------------

# IMPORTANT:
# Raw / processed lunar imagery can be extremely large.
# Keep the actual data outside Git unless intentionally versioned.

data/raw/*
!data/raw/README.md

data/external/*
!data/external/README.md

data/interim/*
!data/interim/README.md

data/processed/*
!data/processed/README.md

data/samples/*
!data/samples/README.md

# ------------------------------------------------------------
# 10. Ground Truth
# ------------------------------------------------------------

# Do NOT blindly ignore all ground truth.
# Small, manually created benchmark metadata should remain versioned.

# Ignore generated / large ground-truth artifacts
data/ground_truth/generated/
data/ground_truth/visualizations/
data/ground_truth/*.csv.tmp
data/ground_truth/*.json.tmp

# Keep documentation and canonical metadata
!data/ground_truth/README.md
!data/ground_truth/CONTROL_POINTS.md
!data/ground_truth/CHECKPOINTS.md

# ------------------------------------------------------------
# 11. Benchmark Data
# ------------------------------------------------------------

# Ignore actual large image pairs / generated benchmark data
benchmarks/v1/pairs/*
!benchmarks/v1/pairs/README.md

benchmarks/v1/generated/
benchmarks/v1/cache/

# Keep benchmark definitions, manifests and protocols
!benchmarks/v1/README.md
!benchmarks/v1/BENCHMARK_SPEC.md
!benchmarks/v1/DATASET_PROTOCOL.md
!benchmarks/v1/GROUND_TRUTH_PROTOCOL.md
!benchmarks/v1/METRICS.md
!benchmarks/v1/STRESS_TESTS.md
!benchmarks/v1/ACCEPTANCE_CRITERIA.md
!benchmarks/v1/REPRODUCIBILITY.md
!benchmarks/v1/manifest.yaml

# ------------------------------------------------------------
# 12. Experiment Outputs
# ------------------------------------------------------------

experiments/**/outputs/
experiments/**/results/
experiments/**/artifacts/
experiments/**/checkpoints/
experiments/**/logs/

# Keep experiment documentation
!experiments/**/README.md

# ------------------------------------------------------------
# 13. Results
# ------------------------------------------------------------

# Generated V1 results
results/v1/metrics/*
results/v1/matches/*
results/v1/overlays/*
results/v1/transforms/*
results/v1/reports/*

# Keep directory documentation
!results/README.md

# Preserve empty directory structure if needed
!results/**/.gitkeep

# ------------------------------------------------------------
# 14. Artifacts
# ------------------------------------------------------------

# Generated figures / demos / reports
artifacts/v1/figures/*
artifacts/v1/demo/*
artifacts/v1/benchmark_tables/*
artifacts/v1/diagrams/generated/*

# Keep documentation
!artifacts/README.md

# ------------------------------------------------------------
# 15. ML / Computer Vision Model Files
# ------------------------------------------------------------

# Model weights can be very large
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.safetensors
*.bin

# TensorFlow
*.h5
*.keras

# Pickle / serialized objects
*.pkl
*.pickle
*.joblib

# ------------------------------------------------------------
# 16. Image / Video Temporary Outputs
# ------------------------------------------------------------

# Generated image outputs
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.webp

# IMPORTANT:
# The above rules ignore ALL images globally.
# Re-include intentionally versioned small project assets below.

# Keep selected repository assets
!frontend/public/**/*.png
!frontend/public/**/*.jpg
!frontend/public/**/*.jpeg
!frontend/public/**/*.svg

# ------------------------------------------------------------
# 17. Geospatial / Remote-Sensing Large Files
# ------------------------------------------------------------

*.geojson
*.gpkg
*.shp
*.shx
*.dbf
*.prj

# Raster products
*.jp2
*.vrt
*.img
*.bil
*.hdr
*.nc
*.hdf
*.h5

# NOTE:
# If a small metadata GeoJSON is intentionally versioned,
# explicitly re-include it with !path/to/file.geojson

# ------------------------------------------------------------
# 18. Large Archives
# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz

# ------------------------------------------------------------
# 19. Docker
# ------------------------------------------------------------

docker-data/
docker-volumes/
*.pid

# ------------------------------------------------------------
# 20. Local Databases
# ------------------------------------------------------------

*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------
# 21. Profiling / Performance
# ------------------------------------------------------------

*.prof
*.profile
*.pstats
*.trace

# ------------------------------------------------------------
# 22. Generated Documentation
# ------------------------------------------------------------

site/
public/build/
docs/_build/
docs/site/
mkdocs_build/

# ------------------------------------------------------------
# 23. OS / Tool Caches
# ------------------------------------------------------------

.cache/
.cache/**
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------
# 24. Local Benchmark Cache
# ------------------------------------------------------------

.benchmark/
benchmark_cache/
benchmarks/**/cache/

# ------------------------------------------------------------
# 25. Local Experiment Cache
# ------------------------------------------------------------

.experiments/
experiment_cache/

# ------------------------------------------------------------
# 26. Local ChandraMap Cache
# ------------------------------------------------------------

.chandramap/
.chandramap-cache/
.cache/chandramap/

# ------------------------------------------------------------
# 27. Generated API / Client Files
# ------------------------------------------------------------

generated/
generated-code/

# ------------------------------------------------------------
# 28. Secrets accidentally generated by tools
# ------------------------------------------------------------

*.secret
*.token
*.credentials
*.credentials.json

# ------------------------------------------------------------
# 29. Temporary benchmark manifests
# ------------------------------------------------------------

*.manifest.tmp
*.benchmark.tmp

# ------------------------------------------------------------
# 30. Local reports
# ------------------------------------------------------------

report.html
report.pdf
benchmark_report.html
benchmark_report.pdf

# ------------------------------------------------------------
# 31. Local test artifacts
# ------------------------------------------------------------

test-results/
test-output/
pytest-results/
junit.xml

# ------------------------------------------------------------
# 32. Mac / Windows / Linux metadata
# ------------------------------------------------------------

Icon?
.directory
*.stackdump

# ------------------------------------------------------------
# 33. Generated API documentation
# ------------------------------------------------------------

.openapi/
swagger-generated/
redoc-static/

# ------------------------------------------------------------
# 34. Temporary archives created by scripts
# ------------------------------------------------------------

downloads/
extracted/
unpacked/

# ------------------------------------------------------------
# 35. Local sample downloads
# ------------------------------------------------------------

downloads/samples/
data/downloads/

# ------------------------------------------------------------
# END
# ============================================================